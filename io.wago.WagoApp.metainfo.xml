<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>io.wago.WagoApp</id>
  <name>Wago App</name>
  <launchable type="desktop-id">io.wago.WagoApp.desktop</launchable>
  <developer id="io.wago">
    <name>The Wago Dev Team</name>
  </developer>
  <project_license>LicenseRef-proprietary</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <url type="homepage">https://addons.wago.io</url>
  <url type="contact">https://addons.wago.io/contact</url>
  <summary>World of Warcraft AddOn Manager</summary>
  <description>
    <p>The Wago App is your all-in-one solution to download and update your World of Warcraft AddOns and WeakAuras.</p>
    <p>Note: if the game is installed to a non-standard path, let Wago App access it:</p>
    <p>flatpak override --filesystem=/path/to/your/wow io.wago.WagoApp</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://addons.wago.io/images/landing/wago-app-landing-page-preview.jpg</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <requires>
    <internet>always</internet>
  </requires>
  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <display_length compare="ge">768</display_length>
  </recommends>
</component>
